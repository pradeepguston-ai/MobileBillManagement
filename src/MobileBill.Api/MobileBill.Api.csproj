<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local secrets (dotnet user-secrets), kept outside the repository, for example the Email credentials. -->
    <UserSecretsId>5b7f3c1e-8d2a-4f6b-9c3e-1a2b3c4d5e6f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local development settings (including the database password) are never published; servers get their settings from environment variables. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobileBill.Application\MobileBill.Application.csproj" />
    <ProjectReference Include="..\MobileBill.Infrastructure\MobileBill.Infrastructure.csproj" />
  </ItemGroup>

</Project>
