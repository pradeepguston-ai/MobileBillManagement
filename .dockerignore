# Build context for the API image (docker-compose builds it from the repository root).
# Keep secrets, local data and build output out of the image.
.git
.github
.vs
.vscode
.claude
.tools
**/bin
**/obj
**/node_modules
**/dist
**/*.user

# Local settings hold the development database password; production settings come from environment variables.
**/appsettings.Development.json
.env
.env.*

# Not needed to build the API.
tests
docs
src/mobilebill-web
**/App_Data
