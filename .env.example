# Copy this file to .env (same folder as docker-compose.yml) and fill in the values.
# .env is git-ignored. Never commit real passwords or keys.

# Port the system is reached on: http://<server>:WEB_PORT
WEB_PORT=8080

# Existing SQL Server database. Use a SQL login (User ID / Password): Windows "Integrated Security" does not work in Linux containers.
# Do not put double quotes inside this value.
# Encrypt=True keeps the SQL password and bill data encrypted on the network. TrustServerCertificate=True accepts the
# server's self-signed certificate; set it to False once SQL Server has a certificate from a trusted authority.
# Use a dedicated SQL login with access to MobileBillDB only, never sa.
DB_CONNECTION_STRING=Data Source=SQL_SERVER_HOST,PORT;Initial Catalog=MobileBillDB;User ID=SQL_USER;Password=SQL_PASSWORD;Pooling=True;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Application Name=MobileBill.Api;Command Timeout=0

# Sign-in tokens. Use a NEW random value of 64+ characters (not the development key).
# The API refuses to start with this placeholder, the development key, or a key under 32 bytes.
# Changing it signs everyone out.
JWT_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=MobileBillManagement
JWT_AUDIENCE=MobileBillManagement
JWT_LIFETIME_MINUTES=480

# Optional. Creates a first Administrator ONLY if the database has none.
# Leave both empty when the database already has users, so nothing is written on start-up.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Time zone for logs.
TZ=Asia/Colombo
